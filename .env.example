APP_AWS_REGION=us-east-1
SALES_BUCKET=my-sales-bucket
SALES_PREFIX=raw/sales
RAW_PREFIX=raw/
RESULTS_PREFIX=results/
DUCKDB_EXTENSION_DIRECTORY=/opt/duckdb_extensions
API_AUTH_MODE=AWS_IAM
ALLOW_PUBLIC_DEMO=false

# NOTE: AWS_REGION is reserved by the Lambda runtime, so the application uses
# APP_AWS_REGION instead. The function also supports AWS_DEFAULT_REGION as a fallback.
